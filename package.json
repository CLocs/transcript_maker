{
  "name": "transcript-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "npm run dev --prefix proxy",
    "dev:all": "concurrently -n proxy,app -c yellow,cyan \"npm run dev:proxy\" \"npm run dev\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:single": "tsc --noEmit -p tsconfig.app.json && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
